#include <winver.h>
#include <usyseek_version.h>
#include "resource.h"

#ifdef USYSEEK_TARGET_UI
#define USYSEEK_RC_DESCRIPTION       "usyseek UI"
#define USYSEEK_RC_INTERNAL_NAME     "usyseek-ui"
#define USYSEEK_RC_ORIGINAL_FILENAME "usyseek-ui.exe"
#define USYSEEK_RC_FILETYPE          VFT_APP
#elif defined(USYSEEK_TARGET_INDEXER)
#define USYSEEK_RC_DESCRIPTION       "usyseek Indexer"
#define USYSEEK_RC_INTERNAL_NAME     "usyseek-indexer"
#define USYSEEK_RC_ORIGINAL_FILENAME "usyseek-indexer.exe"
#define USYSEEK_RC_FILETYPE          VFT_APP
#elif defined(USYSEEK_TARGET_RUST)
#define USYSEEK_RC_DESCRIPTION       "usyseek Rust Runtime"
#define USYSEEK_RC_INTERNAL_NAME     "usyseek_rust"
#define USYSEEK_RC_ORIGINAL_FILENAME "usyseek_rust.dll"
#define USYSEEK_RC_FILETYPE          VFT_DLL
#else
#define USYSEEK_RC_DESCRIPTION       "usyseek"
#define USYSEEK_RC_INTERNAL_NAME     "usyseek"
#define USYSEEK_RC_ORIGINAL_FILENAME "usyseek.exe"
#define USYSEEK_RC_FILETYPE          VFT_APP
#endif

#ifndef USYSEEK_RC_SKIP_ICON
IDI_APP_ICON ICON "icon.ico"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     USYSEEK_VERSION_MAJOR,USYSEEK_VERSION_MINOR,USYSEEK_VERSION_PATCH,USYSEEK_VERSION_TWEAK
PRODUCTVERSION  USYSEEK_VERSION_MAJOR,USYSEEK_VERSION_MINOR,USYSEEK_VERSION_PATCH,USYSEEK_VERSION_TWEAK
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        USYSEEK_RC_FILETYPE
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "usy"
            VALUE "FileDescription",  USYSEEK_RC_DESCRIPTION
            VALUE "FileVersion",      USYSEEK_VERSION_STR
            VALUE "InternalName",     USYSEEK_RC_INTERNAL_NAME
            VALUE "OriginalFilename", USYSEEK_RC_ORIGINAL_FILENAME
            VALUE "ProductName",      "usyseek"
            VALUE "ProductVersion",   USYSEEK_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
